<Window x:Class="WeatherForecastApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="天気予報" Height="720" Width="1120" MinHeight="650" MinWidth="920"
        WindowStartupLocation="CenterScreen" Background="#F3F6FB">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.12" Color="#52627A"/></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1F56C2" Padding="32,22">
            <Grid>
                <StackPanel>
                    <TextBlock Text="WEATHER FORECAST" Foreground="#BFD4FF" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="日本の天気予報" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox x:Name="CityComboBox" Width="190" Height="42" FontSize="15" VerticalContentAlignment="Center"
                              SelectionChanged="CityComboBox_SelectionChanged"/>
                    <Button x:Name="RefreshButton" Content="更新" Width="100" Height="42" Margin="12,0,0,0"
                            Background="White" Foreground="#1F56C2" BorderThickness="0" Click="RefreshButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,26">
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="LocationText" Text="-" FontSize="17" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock x:Name="CurrentWeatherSymbolText" Text="-" FontSize="55" Width="72" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock x:Name="CurrentTemperatureText" Text="--.-℃" FontSize="45" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="CurrentDescriptionText" Text="取得中" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="湿度" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                            <TextBlock x:Name="HumidityText" Text="-- %" FontWeight="Bold" FontSize="25" Margin="0,5,0,18"/>
                            <TextBlock Text="風速" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                            <TextBlock x:Name="WindSpeedText" Text="-- km/h" FontWeight="Bold" FontSize="25" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="最終更新" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                            <TextBlock x:Name="UpdatedAtText" Text="--:--" FontWeight="SemiBold" FontSize="17" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="7日間の予報" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="2,0,0,14"/>
                <ItemsControl x:Name="ForecastItemsControl">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="14" Margin="4" Padding="10,16">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding DateLabel}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding WeatherSymbol}" HorizontalAlignment="Center" FontSize="34" Margin="0,10,0,5"/>
                                    <TextBlock Text="{Binding WeatherDescription}" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock HorizontalAlignment="Center" Margin="0,12,0,0" FontWeight="Bold">
                                        <Run Text="{Binding MaxTemperature, StringFormat={}{0:0.#}℃}" Foreground="#D64B4B"/><Run Text=" / "/><Run Text="{Binding MinTemperature, StringFormat={}{0:0.#}℃}" Foreground="#3478C8"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding PrecipitationProbability, StringFormat=降水 {0}%}" HorizontalAlignment="Center" Foreground="#3478C8" Margin="0,8,0,0" FontSize="13"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" x:Name="StatusBorder" Background="#E8EEF8" Padding="32,12">
            <TextBlock x:Name="StatusText" Text="準備中..." Foreground="#40516B"/>
        </Border>
    </Grid>
</Window>
