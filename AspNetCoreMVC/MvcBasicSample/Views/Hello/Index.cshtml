@*このViewがProductがたを受け取る宣言*@
@model List<MvcBasicSample.Models.Product>;
@{
    ViewData["Title"] = "商品情報"; //タブ用タイトル
    var sum = 0;
}

<h1>商品一覧</h1> @*画面内の見出し*@
<ul>
@foreach(var product in Model)
{
    <li>@product.Name @product.Price 円</li>
    sum += product.Price;
}
</ul>
<p>合計金額：@sum</p>