<Window x:Class="WeatherApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WeatherApp" Height="650" Width="1050" Background="#F3F6FB" WindowStartupLocation="CenterScreen"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#1F56C2" Padding="28"><Grid><TextBlock Text="WeatherApp  日本の天気予報" Foreground="White" FontSize="26" FontWeight="Bold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ComboBox x:Name="CityBox" Width="180" SelectionChanged="CityChanged"/><Button x:Name="UpdateButton" Content="更新" Margin="10,0,0,0" Padding="20,8" Click="UpdateClicked"/></StackPanel></Grid></Border><StackPanel Grid.Row="1" Margin="28"><Border Background="White" CornerRadius="16" Padding="24" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="CityText" FontSize="18"/><TextBlock x:Name="TempText" Text="--℃" FontSize="46" FontWeight="Bold"/><TextBlock x:Name="WeatherText" FontSize="20"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="湿度"/><TextBlock x:Name="HumidityText" FontSize="25" FontWeight="Bold"/><TextBlock Text="風速" Margin="0,16,0,0"/><TextBlock x:Name="WindText" FontSize="25" FontWeight="Bold"/></StackPanel><TextBlock Grid.Column="2" x:Name="UpdatedText" VerticalAlignment="Center"/></Grid></Border><TextBlock Text="7日間の予報" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/><ItemsControl x:Name="ForecastList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="12" Margin="4" Padding="10"><StackPanel HorizontalAlignment="Center"><TextBlock Text="{Binding DateLabel}" FontWeight="Bold"/><TextBlock Text="{Binding Description}" Margin="0,12"/><TextBlock Text="{Binding Max,StringFormat=最高 {0:0.#}℃}" Foreground="#D64B4B"/><TextBlock Text="{Binding Min,StringFormat=最低 {0:0.#}℃}" Foreground="#3478C8"/><TextBlock Text="{Binding Rain,StringFormat=降水 {0}%}" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><Border Grid.Row="2" x:Name="StatusBorder" Background="#E8EEF8" Padding="28,12"><TextBlock x:Name="StatusText" Text="準備中" TextWrapping="Wrap"/></Border></Grid></Window>
